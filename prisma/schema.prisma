// ARA Accounting — database schema (PostgreSQL 16).
// Conventions: see docs/DATABASE_SCHEMA.md. Money columns are Decimal(20,4), rates Decimal(24,10).
// Every tenant table carries organizationId and is protected by row-level security (prisma/migrations/*_rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique // stored lowercase
  name              String
  passwordHash      String
  locale            String    @default("nl")
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean   @default(false)
  mfaSecretEnc      String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes  Json? // array of SHA-256 hashes of unused recovery codes
  isPlatformAdmin   Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions      Session[]
  memberships   OrganizationMembership[]
  assignments   CompanyAssignment[]
  tokens        UserToken[]
  notifications Notification[]
}

/// id = SHA-256 of the session token; the raw token only lives in the HttpOnly cookie.
model Session {
  id                     String    @id
  userId                 String
  activeOrganizationId   String?
  activeCompanyId        String?
  activeAdministrationId String?
  activeFiscalYearId     String?
  mfaVerifiedAt          DateTime?
  createdAt              DateTime  @default(now())
  lastSeenAt             DateTime  @default(now())
  expiresAt              DateTime
  ip                     String?
  userAgent              String?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  INVITATION
}

/// Single-use tokens (only the SHA-256 hash is stored).
model UserToken {
  id             String        @id @default(cuid())
  tokenHash      String        @unique
  kind           UserTokenKind
  userId         String
  organizationId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Failed login attempts for rate limiting (database-backed so it works across serverless instances).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "email:<email>" or "ip:<ip>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ───────────────────────── Tenancy ─────────────────────────

enum OrganizationKind {
  BUSINESS
  ACCOUNTING_FIRM
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Organization {
  id                  String             @id @default(cuid())
  name                String
  settings  Json     @default("{}") // e.g. ai: { enabled, consentAt, consentById } (Phase 7)
  kind                OrganizationKind
  status              OrganizationStatus @default(TRIAL)
  email               String?
  phone               String?
  address             String?
  district            District?
  kkfNumber           String?
  defaultLocale       String             @default("nl")
  requireMfaForAdmins Boolean            @default(true)
  ownerUserId         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  memberships OrganizationMembership[]
  companies   Company[]
  roles       Role[]
}

/// System roles have organizationId = null; organisations may add custom roles later.
model Role {
  id             String                   @id @default(cuid())
  organizationId String?
  code           String
  name           String
  nameEn         String
  orgWide        Boolean                  @default(false) // applies to every company of the organisation
  isSystem       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    OrganizationMembership[]
  assignments    CompanyAssignment[]

  @@unique([organizationId, code])
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

enum LegalForm {
  EENMANSZAAK
  VOF
  CV
  NV
  STICHTING
  VERENIGING
  COOPERATIE
  OVERHEIDS_NV
  KERKGENOOTSCHAP
}

enum District {
  PARAMARIBO
  WANICA
  NICKERIE
  CORONIE
  SARAMACCA
  COMMEWIJNE
  MAROWIJNE
  PARA
  BROKOPONDO
  SIPALIWINI
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

model Company {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  legalName       String?
  legalForm       LegalForm
  kkfNumber       String?
  taxNumber       String?
  btwNumber       String?
  isBtwRegistered Boolean      @default(false)
  address         String?
  district        District?
  email           String?
  phone           String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignments     CompanyAssignment[]
  branches        Branch[]
  administrations Administration[]

  @@unique([organizationId, kkfNumber])
  @@index([organizationId])
}

model CompanyAssignment {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  address        String?
  district       District?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([organizationId])
}

enum AdministrationStatus {
  SETUP
  ACTIVE
  ARCHIVED
}

model Administration {
  id                String               @id @default(cuid())
  organizationId    String
  companyId         String
  code              String
  name              String
  baseCurrency      String               @default("SRD")
  reportingCurrency String?
  framework         String? // annual-accounts template code (Phase 9)
  templateVersionId String? // industry template version the chart was built from (Phase 4)
  status            AdministrationStatus @default(SETUP)
  settings          Json                 @default("{}")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYears       FiscalYear[]

  @@unique([companyId, code])
  @@index([organizationId])
}

enum FiscalYearStatus {
  OPEN
  CLOSING
  CLOSED
}

/// Overlap between fiscal years of one administration is prevented by an exclusion constraint (migration SQL).
model FiscalYear {
  id               String             @id @default(cuid())
  organizationId   String
  administrationId String
  code             String
  startDate        DateTime           @db.Date
  endDate          DateTime           @db.Date
  status           FiscalYearStatus   @default(OPEN)
  createdAt        DateTime           @default(now())
  administration   Administration     @relation(fields: [administrationId], references: [id], onDelete: Cascade)
  periods          AccountingPeriod[]
  entries          JournalEntry[]

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

/// Period 0 = opening balances, 1..12 = months, 13 = year-end adjustments.
model AccountingPeriod {
  id             String         @id @default(cuid())
  organizationId String
  fiscalYearId   String
  number         Int
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  status         PeriodStatus   @default(OPEN)
  closedById     String?
  closedAt       DateTime?
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  entries        JournalEntry[]

  @@unique([fiscalYearId, number])
  @@index([organizationId])
}

// ───────────────────────── Governance ─────────────────────────

/// Append-only and hash-chained per organisation (triggers in migration SQL). Never updated or deleted.
model AuditLog {
  seq            BigInt   @id @default(autoincrement())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  details        Json?
  ip             String?
  createdAt      DateTime @default(now())
  prevHash       String   @default("")
  hash           String   @default("")

  @@index([organizationId, seq])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  params         Json      @default("{}")
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
}

// ───────────────────────── Ledger (Phase 2) ─────────────────────────

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SALES
  OPERATING_EXPENSE
  FINANCIAL_INCOME
  FINANCIAL_EXPENSE
  TAX
  SUSPENSE
}

enum AccountType {
  HEADER
  DETAIL
}

enum BalanceSide {
  DEBIT
  CREDIT
}

/// Control accounts accept postings only from their owning module (ACCOUNTING_RULES L4).
enum ControlType {
  NONE
  RECEIVABLE
  PAYABLE
  BANK
  CASH
  CURRENT_ACCOUNT
  FIXED_ASSET
  TAX
  ROUNDING
  FX_RESULT
  RETAINED_EARNINGS
  RESULT_CURRENT_YEAR
  SUSPENSE
}

model Account {
  id                 String          @id @default(cuid())
  organizationId     String
  administrationId   String
  number             String
  name               String
  nameEn             String?
  description        String?
  category           AccountCategory
  type               AccountType     @default(DETAIL)
  parentId           String?
  normalBalance      BalanceSide
  controlType        ControlType     @default(NONE)
  currency           String? // restricts postings to one transaction currency (e.g. a USD bank account)
  status             RecordStatus    @default(ACTIVE)
  templateAccountRef String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  parent             Account?        @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]       @relation("AccountTree")
  lines              JournalLine[]

  @@unique([administrationId, number])
  @@index([organizationId])
}

enum JournalType {
  PURCHASE
  SALES
  BANK
  CASH
  GENERAL
  OPENING
  FIXED_ASSET
  DEPRECIATION
  TAX
  FX_ADJUSTMENT
  CLOSING
}

model Journal {
  id               String         @id @default(cuid())
  organizationId   String
  administrationId String
  code             String
  name             String
  type             JournalType
  requiresApproval Boolean        @default(false)
  status           RecordStatus   @default(ACTIVE)
  createdAt        DateTime       @default(now())
  entries          JournalEntry[]

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum EntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
}

enum EntryKind {
  NORMAL
  OPENING
  REVERSAL
  CORRECTION
  ADJUSTMENT
  CLOSING
}

enum SourceType {
  MANUAL
  SALES_INVOICE
  PURCHASE_INVOICE
  PAYMENT
  BANK
  CURRENT_ACCOUNT
  ASSET
  DEPRECIATION
  FX_REVALUATION
  YEAR_END
  OPENING
  TAX
  IMPORT
  SCAN
}

/// Posted entries are immutable (database trigger); corrections are reversal/correction entries.
model JournalEntry {
  id                String           @id @default(cuid())
  organizationId    String
  administrationId  String
  journalId         String
  fiscalYearId      String
  periodId          String
  entryNumber       Int? // gapless per journal per fiscal year, assigned when posted
  entryDate         DateTime         @db.Date // posting date: decides the period
  documentDate      DateTime?        @db.Date
  description       String
  reference         String?
  currency          String // base currency of the administration
  status            EntryStatus      @default(DRAFT)
  kind              EntryKind        @default(NORMAL)
  sourceType        SourceType       @default(MANUAL)
  sourceId          String?
  reversesEntryId   String?          @unique
  reversedByEntryId String?          @unique
  reason            String?
  idempotencyKey    String?
  totalDebitBase    Decimal          @default(0) @db.Decimal(20, 4)
  totalCreditBase   Decimal          @default(0) @db.Decimal(20, 4)
  createdById       String
  submittedById     String?
  approvedById      String?
  approvedAt        DateTime?
  postedById        String?
  postedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  journal           Journal          @relation(fields: [journalId], references: [id])
  period            AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fiscalYear        FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reverses          JournalEntry?    @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversedBy        JournalEntry?    @relation("Reversal")
  lines             JournalLine[]

  @@unique([administrationId, idempotencyKey])
  @@unique([journalId, fiscalYearId, entryNumber])
  @@index([organizationId])
  @@index([administrationId, periodId, status])
  @@index([administrationId, status, entryDate])
}

model JournalLine {
  id               String       @id @default(cuid())
  organizationId   String
  administrationId String
  entryId          String
  lineNo           Int
  accountId        String
  description      String?
  debitBase        Decimal      @default(0) @db.Decimal(20, 4)
  creditBase       Decimal      @default(0) @db.Decimal(20, 4)
  txCurrency       String
  txAmount         Decimal      @db.Decimal(20, 4) // signed: debit positive, credit negative
  exchangeRate     Decimal      @default(1) @db.Decimal(24, 10) // 1 txCurrency = rate × base currency
  rateDate         DateTime?    @db.Date
  rateSource       String? // IDENTITY, MANUAL, CBVS_SELL, BANK, …
  costCenterId     String?
  projectId        String?
  departmentId     String?
  partyId          String? // Phase 3
  taxCodeId        String? // Phase 3
  isRounding       Boolean      @default(false)
  entry            JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account          Account      @relation(fields: [accountId], references: [id])

  @@unique([entryId, lineNo])
  @@index([organizationId])
  @@index([administrationId, accountId])
}

enum DimensionType {
  COST_CENTER
  PROJECT
  DEPARTMENT
}

model DimensionValue {
  id               String        @id @default(cuid())
  organizationId   String
  administrationId String
  type             DimensionType
  code             String
  name             String
  status           RecordStatus  @default(ACTIVE)
  createdAt        DateTime      @default(now())

  @@unique([administrationId, type, code])
  @@index([organizationId])
}

/// Gapless number sequences (locked FOR UPDATE inside the posting transaction).
model NumberSequence {
  id             String @id @default(cuid())
  organizationId String
  scope          String // "JOURNAL", "SALES_INVOICE", …
  scopeId        String
  fiscalYearId   String
  nextValue      Int    @default(1)

  @@unique([scope, scopeId, fiscalYearId])
  @@index([organizationId])
}

// ───────────────────────── Financial operations (Phase 3) ─────────────────────────

/// Customer and/or supplier of one administration.
model Party {
  id                      String       @id @default(cuid())
  organizationId          String
  administrationId        String
  code                    String
  name                    String
  isCustomer              Boolean      @default(false)
  isSupplier              Boolean      @default(false)
  kkfNumber               String?
  taxNumber               String?
  btwNumber               String?
  email                   String?
  phone                   String?
  address                 String?
  district                District?
  currency                String       @default("SRD")
  paymentTermDays         Int          @default(30)
  defaultRevenueAccountId String?
  defaultExpenseAccountId String?
  defaultTaxCodeId        String?
  bankName                String?
  bankAccountNumber       String?
  status                  RecordStatus @default(ACTIVE)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  invoices                Invoice[]
  openItems               OpenItem[]
  payments                Payment[]

  @@unique([administrationId, code])
  @@index([organizationId])
  @@index([administrationId, name])
}

enum TaxDirection {
  SALES
  PURCHASE
  BOTH
}

enum TaxKind {
  STANDARD
  LUXURY
  ZERO
  EXEMPT
  IMPORT
  NONE
}

enum LegalStatus {
  VERIFIED
  SOURCE_FOUND
  PENDING_VERIFICATION
}

/// BTW codes are data, never code (ACCOUNTING_RULES T1). The rate is snapshotted on every invoice line.
model TaxCode {
  id               String       @id @default(cuid())
  organizationId   String
  administrationId String
  code             String
  name             String
  nameEn           String?
  kind             TaxKind
  direction        TaxDirection @default(BOTH)
  rate             Decimal      @db.Decimal(9, 4) // percentage, e.g. 10.0000
  deductiblePct    Decimal      @default(100) @db.Decimal(9, 4)
  outputAccountId  String? // sales: BTW payable
  inputAccountId   String? // purchases: BTW receivable
  legalStatus      LegalStatus  @default(PENDING_VERIFICATION)
  legalSource      String?
  reportBox        String?
  validFrom        DateTime?    @db.Date
  validTo          DateTime?    @db.Date
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum FinancialAccountKind {
  BANK
  CASH
}

/// Bank and cash accounts. Each has its own ledger (control) account and journal.
model FinancialAccount {
  id               String               @id @default(cuid())
  organizationId   String
  administrationId String
  kind             FinancialAccountKind
  name             String
  bankCode         String? // DSB, HAKRIN, FINA, REPUBLIC, SCB, GODO, VCB, SPSB, AMANAH, OTHER
  accountNumber    String?
  currency         String
  ledgerAccountId  String
  journalId        String
  importProfile    Json? // CSV column mapping (Phase 3B)
  status           RecordStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now())
  payments         Payment[]

  @@unique([administrationId, kind, bankCode, accountNumber, currency])
  @@index([organizationId])
}

enum InvoiceType {
  SALES
  PURCHASE
}

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  REVIEW
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  administrationId String
  type             InvoiceType
  kind             InvoiceKind   @default(INVOICE)
  partyId          String
  number           String? // sales: gapless, assigned when posted; purchase: internal number when posted
  externalNumber   String? // supplier's invoice number (purchases)
  invoiceDate      DateTime      @db.Date
  dueDate          DateTime      @db.Date
  currency         String
  exchangeRate     Decimal       @default(1) @db.Decimal(24, 10)
  rateSource       String?
  description      String?
  notes            String?
  status           InvoiceStatus @default(DRAFT)
  netAmount        Decimal       @default(0) @db.Decimal(20, 4)
  taxAmount        Decimal       @default(0) @db.Decimal(20, 4)
  grossAmount      Decimal       @default(0) @db.Decimal(20, 4)
  grossBase        Decimal       @default(0) @db.Decimal(20, 4)
  creditsInvoiceId String?
  entryId          String?       @unique
  documentId       String?
  sentAt           DateTime?
  sentTo           String?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  postedById       String?
  postedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  party            Party         @relation(fields: [partyId], references: [id])
  lines            InvoiceLine[]

  @@unique([administrationId, type, number])
  @@index([organizationId])
  @@index([administrationId, type, status])
  @@index([partyId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  lineNo         Int
  description    String
  quantity       Decimal @default(1) @db.Decimal(18, 4)
  unitPrice      Decimal @db.Decimal(20, 4)
  discountPct    Decimal @default(0) @db.Decimal(9, 4)
  netAmount      Decimal @db.Decimal(20, 4)
  taxCodeId      String?
  taxRate        Decimal @default(0) @db.Decimal(9, 4)
  taxAmount      Decimal @default(0) @db.Decimal(20, 4)
  accountId      String
  costCenterId   String?
  projectId      String?
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@index([organizationId])
}

enum OpenItemSide {
  RECEIVABLE
  PAYABLE
}

enum OpenItemStatus {
  OPEN
  SETTLED
}

/// Sub-ledger item (invoice, credit note, payment on account). Amount is signed: + increases the claim/debt.
model OpenItem {
  id               String         @id @default(cuid())
  organizationId   String
  administrationId String
  partyId          String?
  currentAccountId String?
  side             OpenItemSide
  sourceType       String // INVOICE, PAYMENT, OPENING, CURRENT_ACCOUNT
  sourceId         String
  documentNumber   String
  description      String?
  date             DateTime       @db.Date
  dueDate          DateTime       @db.Date
  currency         String
  originalAmount   Decimal        @db.Decimal(20, 4)
  remainingAmount  Decimal        @db.Decimal(20, 4)
  originalRate     Decimal        @default(1) @db.Decimal(24, 10)
  ledgerAccountId  String
  status           OpenItemStatus @default(OPEN)
  lastReminderAt   DateTime?
  createdAt        DateTime       @default(now())
  party            Party?         @relation(fields: [partyId], references: [id])
  allocations      Allocation[]

  @@unique([sourceType, sourceId])
  @@index([organizationId])
  @@index([administrationId, side, status])
  @@index([partyId, status])
}

enum PaymentDirection {
  IN
  OUT
}

model Payment {
  id                 String           @id @default(cuid())
  organizationId     String
  administrationId   String
  direction          PaymentDirection
  partyId            String?
  financialAccountId String
  date               DateTime         @db.Date
  currency           String
  amount             Decimal          @db.Decimal(20, 4)
  exchangeRate       Decimal          @default(1) @db.Decimal(24, 10)
  reference          String?
  description        String?
  bankTransactionId  String?
  entryId            String?          @unique
  idempotencyKey     String?
  createdById        String
  createdAt          DateTime         @default(now())
  party              Party?           @relation(fields: [partyId], references: [id])
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  allocations        Allocation[]

  @@unique([administrationId, idempotencyKey])
  @@index([organizationId])
  @@index([administrationId, date])
}

/// Settles (part of) an open item, by a payment or by another open item (e.g. a credit note).
model Allocation {
  id                String   @id @default(cuid())
  organizationId    String
  openItemId        String
  paymentId         String?
  counterOpenItemId String?
  amount            Decimal  @db.Decimal(20, 4) // in the open item's currency, positive
  createdById       String
  createdAt         DateTime @default(now())
  openItem          OpenItem @relation(fields: [openItemId], references: [id])
  payment           Payment? @relation(fields: [paymentId], references: [id])

  @@index([organizationId])
  @@index([openItemId])
}

// ───────────────────────── Banking (Phase 3B) ─────────────────────────

model BankStatement {
  id                 String            @id @default(cuid())
  organizationId     String
  administrationId   String
  financialAccountId String
  fileName           String
  fileHash           String
  fromDate           DateTime          @db.Date
  toDate             DateTime          @db.Date
  closingBalance     Decimal?          @db.Decimal(20, 4)
  lineCount          Int
  duplicateLines     Int               @default(0)
  importedById       String
  importedAt         DateTime          @default(now())
  transactions       BankTransaction[]

  @@unique([financialAccountId, fileHash])
  @@index([organizationId])
}

enum BankTransactionStatus {
  UNMATCHED
  PARTIAL
  MATCHED
  IGNORED
}

/// One statement line, traceable to its file (statement) and line hash. Duplicate imports are refused.
model BankTransaction {
  id                  String                @id @default(cuid())
  organizationId      String
  administrationId    String
  financialAccountId  String
  statementId         String
  bookingDate         DateTime              @db.Date
  amount              Decimal               @db.Decimal(20, 4) // signed: + in, − out (account currency)
  currency            String
  description         String
  counterpartyName    String?
  counterpartyAccount String?
  bankReference       String?
  lineHash            String
  status              BankTransactionStatus @default(UNMATCHED)
  matchedAmount       Decimal               @default(0) @db.Decimal(20, 4)
  ignoreReason        String?
  createdAt           DateTime              @default(now())
  statement           BankStatement         @relation(fields: [statementId], references: [id])
  matches             BankMatch[]

  @@unique([financialAccountId, lineHash])
  @@index([organizationId])
  @@index([financialAccountId, status, bookingDate])
}

/// How (part of) a bank transaction was processed: a payment allocation or a direct ledger entry.
model BankMatch {
  id                String          @id @default(cuid())
  organizationId    String
  bankTransactionId String
  paymentId         String?
  entryId           String?
  amount            Decimal         @db.Decimal(20, 4)
  createdById       String
  createdAt         DateTime        @default(now())
  transaction       BankTransaction @relation(fields: [bankTransactionId], references: [id])

  @@index([organizationId])
  @@index([bankTransactionId])
}

enum ReconciliationStatus {
  DRAFT
  APPROVED
}

model BankReconciliation {
  id                 String               @id @default(cuid())
  organizationId     String
  administrationId   String
  financialAccountId String
  periodEnd          DateTime             @db.Date
  statementBalance   Decimal              @db.Decimal(20, 4)
  ledgerBalance      Decimal              @db.Decimal(20, 4)
  difference         Decimal              @db.Decimal(20, 4)
  unmatchedCount     Int
  notes              String?
  status             ReconciliationStatus @default(DRAFT)
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime             @default(now())

  @@unique([financialAccountId, periodEnd])
  @@index([organizationId])
}

// ───────────────────────── Current accounts and fixed assets (Phase 3C) ─────────────────────────

enum CurrentAccountKind {
  DIRECTOR
  SHAREHOLDER
  RELATED_PARTY
  INTERCOMPANY
}

/// Rekening-courant with a director, shareholder, related party or group company. Has its own control account.
model CurrentAccount {
  id                    String                       @id @default(cuid())
  organizationId        String
  administrationId      String
  kind                  CurrentAccountKind
  counterpartyName      String
  counterpartyCompanyId String?
  ledgerAccountId       String
  currency              String
  interestRatePct       Decimal?                     @db.Decimal(9, 4)
  agreement             String?
  status                RecordStatus                 @default(ACTIVE)
  createdAt             DateTime                     @default(now())
  confirmations         CurrentAccountConfirmation[]

  @@unique([administrationId, ledgerAccountId])
  @@index([organizationId])
}

/// Balance confirmed by the counterparty at a date (current account reconciliation).
model CurrentAccountConfirmation {
  id               String         @id @default(cuid())
  organizationId   String
  currentAccountId String
  date             DateTime       @db.Date
  confirmedBalance Decimal        @db.Decimal(20, 4)
  ledgerBalance    Decimal        @db.Decimal(20, 4)
  difference       Decimal        @db.Decimal(20, 4)
  notes            String?
  createdById      String
  createdAt        DateTime       @default(now())
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id])

  @@index([organizationId])
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model AssetCategory {
  id                      String             @id @default(cuid())
  organizationId          String
  administrationId        String
  code                    String
  name                    String
  assetAccountId          String
  accumulatedAccountId    String
  expenseAccountId        String
  gainAccountId           String
  lossAccountId           String
  defaultMethod           DepreciationMethod @default(STRAIGHT_LINE)
  defaultUsefulLifeMonths Int                @default(60)
  defaultResidualPct      Decimal            @default(0) @db.Decimal(9, 4)
  status                  RecordStatus       @default(ACTIVE)
  assets                  Asset[]

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum AssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

model Asset {
  id                 String             @id @default(cuid())
  organizationId     String
  administrationId   String
  categoryId         String
  number             String
  name               String
  acquisitionDate    DateTime           @db.Date
  acquisitionCost    Decimal            @db.Decimal(20, 4) // base currency
  residualValue      Decimal            @default(0) @db.Decimal(20, 4)
  usefulLifeMonths   Int
  method             DepreciationMethod @default(STRAIGHT_LINE)
  decliningRatePct   Decimal?           @db.Decimal(9, 4)
  depreciationStart  DateTime           @db.Date // first day of the first depreciation month
  location           String?
  costCenterId       String?
  status             AssetStatus        @default(ACTIVE)
  disposedAt         DateTime?          @db.Date
  disposalProceeds   Decimal?           @db.Decimal(20, 4)
  acquisitionEntryId String?
  createdById        String
  createdAt          DateTime           @default(now())
  category           AssetCategory      @relation(fields: [categoryId], references: [id])
  depreciation       DepreciationLine[]
  history            AssetTransaction[]

  @@unique([administrationId, number])
  @@index([organizationId])
}

/// One month of depreciation for one asset. Unique per asset and month: a month can never be depreciated twice.
model DepreciationLine {
  id             String   @id @default(cuid())
  organizationId String
  assetId        String
  year           Int
  month          Int
  amount         Decimal  @db.Decimal(20, 4)
  entryId        String
  createdAt      DateTime @default(now())
  asset          Asset    @relation(fields: [assetId], references: [id])

  @@unique([assetId, year, month])
  @@index([organizationId])
  @@index([entryId])
}

enum AssetTransactionType {
  ACQUISITION
  DEPRECIATION
  TRANSFER
  DISPOSAL
}

model AssetTransaction {
  id             String               @id @default(cuid())
  organizationId String
  assetId        String
  type           AssetTransactionType
  date           DateTime             @db.Date
  amount         Decimal?             @db.Decimal(20, 4)
  entryId        String?
  details        Json?
  createdById    String
  createdAt      DateTime             @default(now())
  asset          Asset                @relation(fields: [assetId], references: [id])

  @@index([organizationId])
  @@index([assetId])
}

// ───────────── Phase 4: industry templates ─────────────

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
}

/// Industry template. ownerOrganizationId null = platform template (read-only for tenants); otherwise a custom template of that organisation.
model IndustryTemplate {
  id                  String                    @id @default(cuid())
  ownerOrganizationId String?
  code                String
  name                String
  nameEn              String?
  description         String?
  descriptionEn       String?
  basedOnId           String?
  status              RecordStatus              @default(ACTIVE)
  createdAt           DateTime                  @default(now())
  versions            IndustryTemplateVersion[]

  @@unique([ownerOrganizationId, code])
}

/// Immutable once PUBLISHED (trigger). content = validated JSON (accounts, journals, asset categories, dimensions, KPIs).
model IndustryTemplateVersion {
  id                  String                @id @default(cuid())
  ownerOrganizationId String?
  templateId          String
  version             Int
  status              TemplateVersionStatus @default(DRAFT)
  content             Json
  contentHash         String
  changelog           String?
  publishedAt         DateTime?
  createdById         String?
  createdAt           DateTime              @default(now())
  template            IndustryTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

// ───────────── Phase 5: multi-currency ─────────────

enum RateType {
  CBVS_BUY
  CBVS_SELL
  CBVS_MONTH_AVG
  CLOSING
  BANK
  CAMBIO
  MANUAL
}

enum RateSource {
  MANUAL
  CBVS_IMPORT
}

enum RateStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Exchange rate of the organisation: 1 unit of `currency` = `rate` units of `baseCurrency` (e.g. 1 USD = 38.50 SRD).
/// Approved and rejected rates are immutable (trigger); one active rate per currency pair, type and date.
model ExchangeRate {
  id             String     @id @default(cuid())
  organizationId String
  baseCurrency   String
  currency       String
  rateType       RateType
  rate           Decimal    @db.Decimal(20, 10)
  effectiveDate  DateTime   @db.Date
  source         RateSource @default(MANUAL)
  reference      String?
  status         RateStatus @default(PENDING)
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([organizationId, baseCurrency, currency, rateType, effectiveDate])
}

enum RevaluationStatus {
  PROPOSED
  POSTED
  REVERSED
  CANCELLED
}

/// Period-end revaluation of monetary foreign-currency balances (ACCOUNTING_RULES C5–C7).
model CurrencyRevaluation {
  id                String            @id @default(cuid())
  organizationId    String
  administrationId  String
  periodId          String
  revaluationDate   DateTime          @db.Date
  scope             String            @default("ALL")
  status            RevaluationStatus @default(PROPOSED)
  rates             Json
  lines             Json
  entryId           String?
  reversalEntryId   String?
  createdById       String
  createdAt         DateTime          @default(now())

  @@index([organizationId])
  @@index([administrationId, periodId])
}

// ───────────── Phase 6: budgets ─────────────

enum BudgetScenario {
  BASE
  BEST
  WORST
}

enum BudgetVersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED
}

enum BudgetBasis {
  MANUAL
  IMPORT
  PRIOR_ACTUALS
  PRIOR_BUDGET
}

/// Budget for one fiscal year and scenario. Amounts are natural amounts per account (revenue and costs both positive).
model Budget {
  id                String          @id @default(cuid())
  organizationId    String
  administrationId  String
  fiscalYearId      String
  name              String
  scenario          BudgetScenario  @default(BASE)
  alertThresholdPct Decimal         @default(10) @db.Decimal(9, 2)
  status            RecordStatus    @default(ACTIVE)
  createdById       String
  createdAt         DateTime        @default(now())
  versions          BudgetVersion[]

  @@unique([administrationId, fiscalYearId, name, scenario])
  @@index([organizationId])
}

/// B3: an approved version is immutable (trigger); changes go into a new version.
model BudgetVersion {
  id             String              @id @default(cuid())
  organizationId String
  budgetId       String
  version        Int
  status         BudgetVersionStatus @default(DRAFT)
  basis          BudgetBasis         @default(MANUAL)
  adjustmentPct  Decimal             @default(0) @db.Decimal(9, 2)
  notes          String?
  createdById    String
  submittedById  String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  budget         Budget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  lines          BudgetLine[]

  @@unique([budgetId, version])
  @@index([organizationId])
}

model BudgetLine {
  id             String        @id @default(cuid())
  organizationId String
  versionId      String
  accountId      String
  /// Cost centre or project dimension value; "" when the line is for the whole account.
  dimensionId    String        @default("")
  period         Int
  amount         Decimal       @db.Decimal(20, 2)
  version        BudgetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, accountId, dimensionId, period])
  @@index([organizationId])
}

// ───────────── Phase 7: ARA Scan, AI and automation ─────────────

enum DocumentStatus {
  UPLOADED
  REVIEW_REQUIRED
  PROCESSED
  REJECTED
}

enum DocumentSource {
  WEB
  MOBILE
}

/// A scanned or uploaded purchase document. The file itself is in DocumentFile (database storage adapter).
enum DocumentKind {
  PURCHASE
  EVIDENCE
}

model Document {
  id               String         @id @default(cuid())
  organizationId   String
  administrationId String
  kind             DocumentKind   @default(PURCHASE)
  fileName         String
  mimeType         String
  sizeBytes        Int
  sha256           String
  pageCount        Int?
  source           DocumentSource @default(WEB)
  status           DocumentStatus @default(UPLOADED)
  textContent      String?
  /// AI1: values confirmed by the user are kept apart from suggestions (DocumentExtraction).
  confirmed        Json?
  invoiceId        String?
  duplicateOfId    String?
  duplicateReason  String?
  rejectReason     String?
  uploadedById     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([administrationId, sha256])
  @@index([organizationId])
}

model DocumentFile {
  documentId     String @id
  organizationId String
  data           Bytes
}

/// Suggestions from one extraction run (text layer or AI provider). Append-only.
model DocumentExtraction {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  provider       String
  model          String?
  fields         Json
  durationMs     Int
  error          String?
  createdAt      DateTime @default(now())

  @@index([documentId])
  @@index([organizationId])
}

enum AutomationMode {
  SUGGEST
  DRAFT
  AUTO_POST
}

/// Supplier rule: documents of this supplier get this account and BTW code; the mode decides how far automation goes (AI2).
model AutomationRule {
  id                  String         @id @default(cuid())
  organizationId      String
  administrationId    String
  name                String
  partyId             String
  descriptionContains String?
  accountId           String
  taxCodeId           String?
  mode                AutomationMode @default(SUGGEST)
  minConfidence       Decimal        @default(0.9) @db.Decimal(4, 3)
  maxAmount           Decimal?       @db.Decimal(20, 2)
  enabled             Boolean        @default(true)
  createdById         String
  createdAt           DateTime       @default(now())

  @@index([administrationId, partyId])
  @@index([organizationId])
}

enum AutomationOutcome {
  SUGGESTED
  DRAFTED
  POSTED
  REVIEW
  FAILED
}

/// Automation monitor: every automated decision with its reasons. Append-only.
model AutomationExecution {
  id               String            @id @default(cuid())
  organizationId   String
  administrationId String
  ruleId           String?
  documentId       String?
  outcome          AutomationOutcome
  reasons          Json
  durationMs       Int
  createdAt        DateTime          @default(now())

  @@index([administrationId, createdAt])
  @@index([organizationId])
}

// ───────────── Phase 8: reporting ─────────────

/// R1: every exported report stores its parameters and the ledger fingerprint (count + hash of the included entries). Append-only.
model ReportRun {
  id               String   @id @default(cuid())
  organizationId   String
  administrationId String
  kind             String
  format           String
  params           Json
  fingerprint      String
  entryCount       Int
  createdById      String
  createdAt        DateTime @default(now())

  @@index([administrationId, createdAt])
  @@index([organizationId])
}

// ───────────── Phase 9: year-end ─────────────

enum YearEndStatus {
  IN_PROGRESS
  REVIEW
  APPROVED
  CLOSED
}

enum ChecklistStatus {
  OPEN
  COMPLETED
  NOT_APPLICABLE
}

/// One year-end closing per fiscal year (F4–F6).
model YearEndClosing {
  id               String                 @id @default(cuid())
  organizationId   String
  administrationId String
  fiscalYearId     String                 @unique
  status           YearEndStatus          @default(IN_PROGRESS)
  submittedById    String?
  approvedById     String?
  approvedAt       DateTime?
  closedById       String?
  closedAt         DateTime?
  closingEntryId   String?
  openingEntryId   String?
  reopenCount      Int                    @default(0)
  createdById      String
  createdAt        DateTime               @default(now())
  items            YearEndChecklistItem[]

  @@index([organizationId])
}

model YearEndChecklistItem {
  id             String          @id @default(cuid())
  organizationId String
  closingId      String
  code           String
  sortOrder      Int
  mandatory      Boolean
  status         ChecklistStatus @default(OPEN)
  comment        String?
  completedById  String?
  completedAt    DateTime?
  closing        YearEndClosing  @relation(fields: [closingId], references: [id], onDelete: Cascade)

  @@unique([closingId, code])
  @@index([organizationId])
}

// ───────────── Phase 9: tax ─────────────

enum TaxType {
  BTW
  IB_RECHTSPERSONEN
  DIVIDENDBELASTING
}

enum RuleLegalStatus {
  VERIFIED
  SOURCE_FOUND
  PENDING_VERIFICATION
}

/// T1: rates and other tax parameters are versioned data with an effective date and a legal status (platform-wide, read-only for tenants).
model TaxRuleVersion {
  id            String          @id @default(cuid())
  taxType       TaxType
  effectiveFrom DateTime        @db.Date
  effectiveTo   DateTime?       @db.Date
  parameters    Json
  legalStatus   RuleLegalStatus
  legalSource   String?
  notes         String?
  createdAt     DateTime        @default(now())

  @@unique([taxType, effectiveFrom])
}

enum TaxReturnStatus {
  DRAFT
  APPROVED
  FILED
}

/// A tax return or calculation: monthly BTW, yearly IB rechtspersonen, or a dividend declaration.
model TaxReturn {
  id                  String          @id @default(cuid())
  organizationId      String
  administrationId    String
  taxType             TaxType
  periodFrom          DateTime        @db.Date
  periodTo            DateTime        @db.Date
  fiscalYearId        String?
  ruleVersionId       String
  status              TaxReturnStatus @default(DRAFT)
  calculation         Json
  /// T2: explicit acknowledgement when the rule is not VERIFIED.
  acknowledgedById    String?
  acknowledgedAt      DateTime?
  explanation         String?
  approvedById        String?
  approvedAt          DateTime?
  entryId             String?
  evidenceDocumentId  String?
  filingReference     String?
  filedById           String?
  filedAt             DateTime?
  createdById         String
  createdAt           DateTime        @default(now())
  adjustments         TaxAdjustment[]

  @@unique([administrationId, taxType, periodFrom, periodTo])
  @@index([organizationId])
}

enum TaxAdjustmentKind {
  NON_DEDUCTIBLE
  EXEMPT_INCOME
  DEPRECIATION_DIFFERENCE
  LOSS_OFFSET
  OTHER
}

/// T6 fiscal adjustment: signed amount added to the commercial result.
model TaxAdjustment {
  id             String            @id @default(cuid())
  organizationId String
  returnId       String
  kind           TaxAdjustmentKind
  description    String
  amount         Decimal           @db.Decimal(20, 2)
  createdById    String
  createdAt      DateTime          @default(now())
  taxReturn      TaxReturn         @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ───────────── Phase 9: annual accounts ─────────────

enum AnnualFramework {
  NV_IFRS_SME
  NV_FULL_IFRS
  SOLE_PROPRIETOR
  FOUNDATION
}

enum AnnualAccountStatus {
  DRAFT
  REVIEW
  APPROVED
  FINAL
}

/// Annual accounts (jaarrekening) generated from the closed ledger; FINAL is immutable (trigger).
model AnnualAccount {
  id               String                @id @default(cuid())
  organizationId   String
  administrationId String
  fiscalYearId     String                @unique
  framework        AnnualFramework
  status           AnnualAccountStatus   @default(DRAFT)
  snapshot         Json
  fingerprint      String
  entryCount       Int
  submittedById    String?
  approvedById     String?
  approvedAt       DateTime?
  finalizedById    String?
  finalizedAt      DateTime?
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  disclosures      FinancialDisclosure[]

  @@index([organizationId])
}

model FinancialDisclosure {
  id              String        @id @default(cuid())
  organizationId  String
  annualAccountId String
  code            String
  title           String
  body            String
  sortOrder       Int
  auto            Boolean       @default(false)
  annualAccount   AnnualAccount @relation(fields: [annualAccountId], references: [id], onDelete: Cascade)

  @@unique([annualAccountId, code])
  @@index([organizationId])
}
