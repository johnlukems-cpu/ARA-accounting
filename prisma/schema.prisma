// ARA Accounting — database schema (PostgreSQL 16).
// Conventions: see docs/DATABASE_SCHEMA.md. Money columns are Decimal(20,4), rates Decimal(24,10).
// Every tenant table carries organizationId and is protected by row-level security (prisma/migrations/*_rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique // stored lowercase
  name              String
  passwordHash      String
  locale            String    @default("nl")
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean   @default(false)
  mfaSecretEnc      String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes  Json? // array of SHA-256 hashes of unused recovery codes
  isPlatformAdmin   Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions      Session[]
  memberships   OrganizationMembership[]
  assignments   CompanyAssignment[]
  tokens        UserToken[]
  notifications Notification[]
}

/// id = SHA-256 of the session token; the raw token only lives in the HttpOnly cookie.
model Session {
  id                     String    @id
  userId                 String
  activeOrganizationId   String?
  activeCompanyId        String?
  activeAdministrationId String?
  activeFiscalYearId     String?
  mfaVerifiedAt          DateTime?
  createdAt              DateTime  @default(now())
  lastSeenAt             DateTime  @default(now())
  expiresAt              DateTime
  ip                     String?
  userAgent              String?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  INVITATION
}

/// Single-use tokens (only the SHA-256 hash is stored).
model UserToken {
  id             String        @id @default(cuid())
  tokenHash      String        @unique
  kind           UserTokenKind
  userId         String
  organizationId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Failed login attempts for rate limiting (database-backed so it works across serverless instances).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "email:<email>" or "ip:<ip>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ───────────────────────── Tenancy ─────────────────────────

enum OrganizationKind {
  BUSINESS
  ACCOUNTING_FIRM
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Organization {
  id                  String             @id @default(cuid())
  name                String
  kind                OrganizationKind
  status              OrganizationStatus @default(TRIAL)
  email               String?
  phone               String?
  address             String?
  district            District?
  kkfNumber           String?
  defaultLocale       String             @default("nl")
  requireMfaForAdmins Boolean            @default(true)
  ownerUserId         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  memberships OrganizationMembership[]
  companies   Company[]
  roles       Role[]
}

/// System roles have organizationId = null; organisations may add custom roles later.
model Role {
  id             String                   @id @default(cuid())
  organizationId String?
  code           String
  name           String
  nameEn         String
  orgWide        Boolean                  @default(false) // applies to every company of the organisation
  isSystem       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    OrganizationMembership[]
  assignments    CompanyAssignment[]

  @@unique([organizationId, code])
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

enum LegalForm {
  EENMANSZAAK
  VOF
  CV
  NV
  STICHTING
  VERENIGING
  COOPERATIE
  OVERHEIDS_NV
  KERKGENOOTSCHAP
}

enum District {
  PARAMARIBO
  WANICA
  NICKERIE
  CORONIE
  SARAMACCA
  COMMEWIJNE
  MAROWIJNE
  PARA
  BROKOPONDO
  SIPALIWINI
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

model Company {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  legalName       String?
  legalForm       LegalForm
  kkfNumber       String?
  taxNumber       String?
  btwNumber       String?
  isBtwRegistered Boolean      @default(false)
  address         String?
  district        District?
  email           String?
  phone           String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignments     CompanyAssignment[]
  branches        Branch[]
  administrations Administration[]

  @@unique([organizationId, kkfNumber])
  @@index([organizationId])
}

model CompanyAssignment {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role     @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  address        String?
  district       District?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([organizationId])
}

enum AdministrationStatus {
  SETUP
  ACTIVE
  ARCHIVED
}

model Administration {
  id                String               @id @default(cuid())
  organizationId    String
  companyId         String
  code              String
  name              String
  baseCurrency      String               @default("SRD")
  reportingCurrency String?
  framework         String? // annual-accounts template code (Phase 9)
  templateVersionId String? // industry template version the chart was built from (Phase 4)
  status            AdministrationStatus @default(SETUP)
  settings          Json                 @default("{}")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYears       FiscalYear[]

  @@unique([companyId, code])
  @@index([organizationId])
}

enum FiscalYearStatus {
  OPEN
  CLOSING
  CLOSED
}

/// Overlap between fiscal years of one administration is prevented by an exclusion constraint (migration SQL).
model FiscalYear {
  id               String             @id @default(cuid())
  organizationId   String
  administrationId String
  code             String
  startDate        DateTime           @db.Date
  endDate          DateTime           @db.Date
  status           FiscalYearStatus   @default(OPEN)
  createdAt        DateTime           @default(now())
  administration   Administration     @relation(fields: [administrationId], references: [id], onDelete: Cascade)
  periods          AccountingPeriod[]
  entries          JournalEntry[]

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

/// Period 0 = opening balances, 1..12 = months, 13 = year-end adjustments.
model AccountingPeriod {
  id             String         @id @default(cuid())
  organizationId String
  fiscalYearId   String
  number         Int
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  status         PeriodStatus   @default(OPEN)
  closedById     String?
  closedAt       DateTime?
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  entries        JournalEntry[]

  @@unique([fiscalYearId, number])
  @@index([organizationId])
}

// ───────────────────────── Governance ─────────────────────────

/// Append-only and hash-chained per organisation (triggers in migration SQL). Never updated or deleted.
model AuditLog {
  seq            BigInt   @id @default(autoincrement())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  details        Json?
  ip             String?
  createdAt      DateTime @default(now())
  prevHash       String   @default("")
  hash           String   @default("")

  @@index([organizationId, seq])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  params         Json      @default("{}")
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
}

// ───────────────────────── Ledger (Phase 2) ─────────────────────────

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SALES
  OPERATING_EXPENSE
  FINANCIAL_INCOME
  FINANCIAL_EXPENSE
  TAX
  SUSPENSE
}

enum AccountType {
  HEADER
  DETAIL
}

enum BalanceSide {
  DEBIT
  CREDIT
}

/// Control accounts accept postings only from their owning module (ACCOUNTING_RULES L4).
enum ControlType {
  NONE
  RECEIVABLE
  PAYABLE
  BANK
  CASH
  CURRENT_ACCOUNT
  FIXED_ASSET
  TAX
  ROUNDING
  FX_RESULT
  RETAINED_EARNINGS
  RESULT_CURRENT_YEAR
  SUSPENSE
}

model Account {
  id                 String          @id @default(cuid())
  organizationId     String
  administrationId   String
  number             String
  name               String
  nameEn             String?
  description        String?
  category           AccountCategory
  type               AccountType     @default(DETAIL)
  parentId           String?
  normalBalance      BalanceSide
  controlType        ControlType     @default(NONE)
  currency           String? // restricts postings to one transaction currency (e.g. a USD bank account)
  status             RecordStatus    @default(ACTIVE)
  templateAccountRef String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  parent             Account?        @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]       @relation("AccountTree")
  lines              JournalLine[]

  @@unique([administrationId, number])
  @@index([organizationId])
}

enum JournalType {
  PURCHASE
  SALES
  BANK
  CASH
  GENERAL
  OPENING
  FIXED_ASSET
  DEPRECIATION
  TAX
  FX_ADJUSTMENT
  CLOSING
}

model Journal {
  id               String         @id @default(cuid())
  organizationId   String
  administrationId String
  code             String
  name             String
  type             JournalType
  requiresApproval Boolean        @default(false)
  status           RecordStatus   @default(ACTIVE)
  createdAt        DateTime       @default(now())
  entries          JournalEntry[]

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum EntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
}

enum EntryKind {
  NORMAL
  OPENING
  REVERSAL
  CORRECTION
  ADJUSTMENT
  CLOSING
}

enum SourceType {
  MANUAL
  SALES_INVOICE
  PURCHASE_INVOICE
  PAYMENT
  BANK
  CURRENT_ACCOUNT
  ASSET
  DEPRECIATION
  FX_REVALUATION
  YEAR_END
  OPENING
  TAX
  IMPORT
  SCAN
}

/// Posted entries are immutable (database trigger); corrections are reversal/correction entries.
model JournalEntry {
  id                String           @id @default(cuid())
  organizationId    String
  administrationId  String
  journalId         String
  fiscalYearId      String
  periodId          String
  entryNumber       Int? // gapless per journal per fiscal year, assigned when posted
  entryDate         DateTime         @db.Date // posting date: decides the period
  documentDate      DateTime?        @db.Date
  description       String
  reference         String?
  currency          String // base currency of the administration
  status            EntryStatus      @default(DRAFT)
  kind              EntryKind        @default(NORMAL)
  sourceType        SourceType       @default(MANUAL)
  sourceId          String?
  reversesEntryId   String?          @unique
  reversedByEntryId String?          @unique
  reason            String?
  idempotencyKey    String?
  totalDebitBase    Decimal          @default(0) @db.Decimal(20, 4)
  totalCreditBase   Decimal          @default(0) @db.Decimal(20, 4)
  createdById       String
  submittedById     String?
  approvedById      String?
  approvedAt        DateTime?
  postedById        String?
  postedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  journal           Journal          @relation(fields: [journalId], references: [id])
  period            AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fiscalYear        FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reverses          JournalEntry?    @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversedBy        JournalEntry?    @relation("Reversal")
  lines             JournalLine[]

  @@unique([administrationId, idempotencyKey])
  @@unique([journalId, fiscalYearId, entryNumber])
  @@index([organizationId])
  @@index([administrationId, periodId, status])
  @@index([administrationId, status, entryDate])
}

model JournalLine {
  id               String       @id @default(cuid())
  organizationId   String
  administrationId String
  entryId          String
  lineNo           Int
  accountId        String
  description      String?
  debitBase        Decimal      @default(0) @db.Decimal(20, 4)
  creditBase       Decimal      @default(0) @db.Decimal(20, 4)
  txCurrency       String
  txAmount         Decimal      @db.Decimal(20, 4) // signed: debit positive, credit negative
  exchangeRate     Decimal      @default(1) @db.Decimal(24, 10) // 1 txCurrency = rate × base currency
  rateDate         DateTime?    @db.Date
  rateSource       String? // IDENTITY, MANUAL, CBVS_SELL, BANK, …
  costCenterId     String?
  projectId        String?
  departmentId     String?
  partyId          String? // Phase 3
  taxCodeId        String? // Phase 3
  isRounding       Boolean      @default(false)
  entry            JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account          Account      @relation(fields: [accountId], references: [id])

  @@unique([entryId, lineNo])
  @@index([organizationId])
  @@index([administrationId, accountId])
}

enum DimensionType {
  COST_CENTER
  PROJECT
  DEPARTMENT
}

model DimensionValue {
  id               String        @id @default(cuid())
  organizationId   String
  administrationId String
  type             DimensionType
  code             String
  name             String
  status           RecordStatus  @default(ACTIVE)
  createdAt        DateTime      @default(now())

  @@unique([administrationId, type, code])
  @@index([organizationId])
}

/// Gapless number sequences (locked FOR UPDATE inside the posting transaction).
model NumberSequence {
  id             String @id @default(cuid())
  organizationId String
  scope          String // "JOURNAL", "SALES_INVOICE", …
  scopeId        String
  fiscalYearId   String
  nextValue      Int    @default(1)

  @@unique([scope, scopeId, fiscalYearId])
  @@index([organizationId])
}

// ───────────────────────── Financial operations (Phase 3) ─────────────────────────

/// Customer and/or supplier of one administration.
model Party {
  id                      String       @id @default(cuid())
  organizationId          String
  administrationId        String
  code                    String
  name                    String
  isCustomer              Boolean      @default(false)
  isSupplier              Boolean      @default(false)
  kkfNumber               String?
  taxNumber               String?
  btwNumber               String?
  email                   String?
  phone                   String?
  address                 String?
  district                District?
  currency                String       @default("SRD")
  paymentTermDays         Int          @default(30)
  defaultRevenueAccountId String?
  defaultExpenseAccountId String?
  defaultTaxCodeId        String?
  bankName                String?
  bankAccountNumber       String?
  status                  RecordStatus @default(ACTIVE)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  invoices                Invoice[]
  openItems               OpenItem[]
  payments                Payment[]

  @@unique([administrationId, code])
  @@index([organizationId])
  @@index([administrationId, name])
}

enum TaxDirection {
  SALES
  PURCHASE
  BOTH
}

enum TaxKind {
  STANDARD
  LUXURY
  ZERO
  EXEMPT
  IMPORT
  NONE
}

enum LegalStatus {
  VERIFIED
  SOURCE_FOUND
  PENDING_VERIFICATION
}

/// BTW codes are data, never code (ACCOUNTING_RULES T1). The rate is snapshotted on every invoice line.
model TaxCode {
  id               String       @id @default(cuid())
  organizationId   String
  administrationId String
  code             String
  name             String
  nameEn           String?
  kind             TaxKind
  direction        TaxDirection @default(BOTH)
  rate             Decimal      @db.Decimal(9, 4) // percentage, e.g. 10.0000
  deductiblePct    Decimal      @default(100) @db.Decimal(9, 4)
  outputAccountId  String? // sales: BTW payable
  inputAccountId   String? // purchases: BTW receivable
  legalStatus      LegalStatus  @default(PENDING_VERIFICATION)
  legalSource      String?
  reportBox        String?
  validFrom        DateTime?    @db.Date
  validTo          DateTime?    @db.Date
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum FinancialAccountKind {
  BANK
  CASH
}

/// Bank and cash accounts. Each has its own ledger (control) account and journal.
model FinancialAccount {
  id               String               @id @default(cuid())
  organizationId   String
  administrationId String
  kind             FinancialAccountKind
  name             String
  bankCode         String? // DSB, HAKRIN, FINA, REPUBLIC, SCB, GODO, VCB, SPSB, AMANAH, OTHER
  accountNumber    String?
  currency         String
  ledgerAccountId  String
  journalId        String
  importProfile    Json? // CSV column mapping (Phase 3B)
  status           RecordStatus         @default(ACTIVE)
  createdAt        DateTime             @default(now())
  payments         Payment[]

  @@unique([administrationId, kind, bankCode, accountNumber, currency])
  @@index([organizationId])
}

enum InvoiceType {
  SALES
  PURCHASE
}

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  REVIEW
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
}

model Invoice {
  id               String        @id @default(cuid())
  organizationId   String
  administrationId String
  type             InvoiceType
  kind             InvoiceKind   @default(INVOICE)
  partyId          String
  number           String? // sales: gapless, assigned when posted; purchase: internal number when posted
  externalNumber   String? // supplier's invoice number (purchases)
  invoiceDate      DateTime      @db.Date
  dueDate          DateTime      @db.Date
  currency         String
  exchangeRate     Decimal       @default(1) @db.Decimal(24, 10)
  rateSource       String?
  description      String?
  notes            String?
  status           InvoiceStatus @default(DRAFT)
  netAmount        Decimal       @default(0) @db.Decimal(20, 4)
  taxAmount        Decimal       @default(0) @db.Decimal(20, 4)
  grossAmount      Decimal       @default(0) @db.Decimal(20, 4)
  grossBase        Decimal       @default(0) @db.Decimal(20, 4)
  creditsInvoiceId String?
  entryId          String?       @unique
  documentId       String?
  sentAt           DateTime?
  sentTo           String?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  postedById       String?
  postedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  party            Party         @relation(fields: [partyId], references: [id])
  lines            InvoiceLine[]

  @@unique([administrationId, type, number])
  @@index([organizationId])
  @@index([administrationId, type, status])
  @@index([partyId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  organizationId String
  invoiceId      String
  lineNo         Int
  description    String
  quantity       Decimal @default(1) @db.Decimal(18, 4)
  unitPrice      Decimal @db.Decimal(20, 4)
  discountPct    Decimal @default(0) @db.Decimal(9, 4)
  netAmount      Decimal @db.Decimal(20, 4)
  taxCodeId      String?
  taxRate        Decimal @default(0) @db.Decimal(9, 4)
  taxAmount      Decimal @default(0) @db.Decimal(20, 4)
  accountId      String
  costCenterId   String?
  projectId      String?
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@index([organizationId])
}

enum OpenItemSide {
  RECEIVABLE
  PAYABLE
}

enum OpenItemStatus {
  OPEN
  SETTLED
}

/// Sub-ledger item (invoice, credit note, payment on account). Amount is signed: + increases the claim/debt.
model OpenItem {
  id               String         @id @default(cuid())
  organizationId   String
  administrationId String
  partyId          String?
  currentAccountId String?
  side             OpenItemSide
  sourceType       String // INVOICE, PAYMENT, OPENING, CURRENT_ACCOUNT
  sourceId         String
  documentNumber   String
  description      String?
  date             DateTime       @db.Date
  dueDate          DateTime       @db.Date
  currency         String
  originalAmount   Decimal        @db.Decimal(20, 4)
  remainingAmount  Decimal        @db.Decimal(20, 4)
  originalRate     Decimal        @default(1) @db.Decimal(24, 10)
  ledgerAccountId  String
  status           OpenItemStatus @default(OPEN)
  lastReminderAt   DateTime?
  createdAt        DateTime       @default(now())
  party            Party?         @relation(fields: [partyId], references: [id])
  allocations      Allocation[]

  @@unique([sourceType, sourceId])
  @@index([organizationId])
  @@index([administrationId, side, status])
  @@index([partyId, status])
}

enum PaymentDirection {
  IN
  OUT
}

model Payment {
  id                 String           @id @default(cuid())
  organizationId     String
  administrationId   String
  direction          PaymentDirection
  partyId            String?
  financialAccountId String
  date               DateTime         @db.Date
  currency           String
  amount             Decimal          @db.Decimal(20, 4)
  exchangeRate       Decimal          @default(1) @db.Decimal(24, 10)
  reference          String?
  description        String?
  bankTransactionId  String?
  entryId            String?          @unique
  idempotencyKey     String?
  createdById        String
  createdAt          DateTime         @default(now())
  party              Party?           @relation(fields: [partyId], references: [id])
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  allocations        Allocation[]

  @@unique([administrationId, idempotencyKey])
  @@index([organizationId])
  @@index([administrationId, date])
}

/// Settles (part of) an open item, by a payment or by another open item (e.g. a credit note).
model Allocation {
  id                String   @id @default(cuid())
  organizationId    String
  openItemId        String
  paymentId         String?
  counterOpenItemId String?
  amount            Decimal  @db.Decimal(20, 4) // in the open item's currency, positive
  createdById       String
  createdAt         DateTime @default(now())
  openItem          OpenItem @relation(fields: [openItemId], references: [id])
  payment           Payment? @relation(fields: [paymentId], references: [id])

  @@index([organizationId])
  @@index([openItemId])
}

// ───────────────────────── Banking (Phase 3B) ─────────────────────────

model BankStatement {
  id                 String            @id @default(cuid())
  organizationId     String
  administrationId   String
  financialAccountId String
  fileName           String
  fileHash           String
  fromDate           DateTime          @db.Date
  toDate             DateTime          @db.Date
  closingBalance     Decimal?          @db.Decimal(20, 4)
  lineCount          Int
  duplicateLines     Int               @default(0)
  importedById       String
  importedAt         DateTime          @default(now())
  transactions       BankTransaction[]

  @@unique([financialAccountId, fileHash])
  @@index([organizationId])
}

enum BankTransactionStatus {
  UNMATCHED
  PARTIAL
  MATCHED
  IGNORED
}

/// One statement line, traceable to its file (statement) and line hash. Duplicate imports are refused.
model BankTransaction {
  id                  String                @id @default(cuid())
  organizationId      String
  administrationId    String
  financialAccountId  String
  statementId         String
  bookingDate         DateTime              @db.Date
  amount              Decimal               @db.Decimal(20, 4) // signed: + in, − out (account currency)
  currency            String
  description         String
  counterpartyName    String?
  counterpartyAccount String?
  bankReference       String?
  lineHash            String
  status              BankTransactionStatus @default(UNMATCHED)
  matchedAmount       Decimal               @default(0) @db.Decimal(20, 4)
  ignoreReason        String?
  createdAt           DateTime              @default(now())
  statement           BankStatement         @relation(fields: [statementId], references: [id])
  matches             BankMatch[]

  @@unique([financialAccountId, lineHash])
  @@index([organizationId])
  @@index([financialAccountId, status, bookingDate])
}

/// How (part of) a bank transaction was processed: a payment allocation or a direct ledger entry.
model BankMatch {
  id                String          @id @default(cuid())
  organizationId    String
  bankTransactionId String
  paymentId         String?
  entryId           String?
  amount            Decimal         @db.Decimal(20, 4)
  createdById       String
  createdAt         DateTime        @default(now())
  transaction       BankTransaction @relation(fields: [bankTransactionId], references: [id])

  @@index([organizationId])
  @@index([bankTransactionId])
}

enum ReconciliationStatus {
  DRAFT
  APPROVED
}

model BankReconciliation {
  id                 String               @id @default(cuid())
  organizationId     String
  administrationId   String
  financialAccountId String
  periodEnd          DateTime             @db.Date
  statementBalance   Decimal              @db.Decimal(20, 4)
  ledgerBalance      Decimal              @db.Decimal(20, 4)
  difference         Decimal              @db.Decimal(20, 4)
  unmatchedCount     Int
  notes              String?
  status             ReconciliationStatus @default(DRAFT)
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime             @default(now())

  @@unique([financialAccountId, periodEnd])
  @@index([organizationId])
}

// ───────────────────────── Current accounts and fixed assets (Phase 3C) ─────────────────────────

enum CurrentAccountKind {
  DIRECTOR
  SHAREHOLDER
  RELATED_PARTY
  INTERCOMPANY
}

/// Rekening-courant with a director, shareholder, related party or group company. Has its own control account.
model CurrentAccount {
  id                    String                       @id @default(cuid())
  organizationId        String
  administrationId      String
  kind                  CurrentAccountKind
  counterpartyName      String
  counterpartyCompanyId String?
  ledgerAccountId       String
  currency              String
  interestRatePct       Decimal?                     @db.Decimal(9, 4)
  agreement             String?
  status                RecordStatus                 @default(ACTIVE)
  createdAt             DateTime                     @default(now())
  confirmations         CurrentAccountConfirmation[]

  @@unique([administrationId, ledgerAccountId])
  @@index([organizationId])
}

/// Balance confirmed by the counterparty at a date (current account reconciliation).
model CurrentAccountConfirmation {
  id               String         @id @default(cuid())
  organizationId   String
  currentAccountId String
  date             DateTime       @db.Date
  confirmedBalance Decimal        @db.Decimal(20, 4)
  ledgerBalance    Decimal        @db.Decimal(20, 4)
  difference       Decimal        @db.Decimal(20, 4)
  notes            String?
  createdById      String
  createdAt        DateTime       @default(now())
  currentAccount   CurrentAccount @relation(fields: [currentAccountId], references: [id])

  @@index([organizationId])
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model AssetCategory {
  id                      String             @id @default(cuid())
  organizationId          String
  administrationId        String
  code                    String
  name                    String
  assetAccountId          String
  accumulatedAccountId    String
  expenseAccountId        String
  gainAccountId           String
  lossAccountId           String
  defaultMethod           DepreciationMethod @default(STRAIGHT_LINE)
  defaultUsefulLifeMonths Int                @default(60)
  defaultResidualPct      Decimal            @default(0) @db.Decimal(9, 4)
  status                  RecordStatus       @default(ACTIVE)
  assets                  Asset[]

  @@unique([administrationId, code])
  @@index([organizationId])
}

enum AssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

model Asset {
  id                 String             @id @default(cuid())
  organizationId     String
  administrationId   String
  categoryId         String
  number             String
  name               String
  acquisitionDate    DateTime           @db.Date
  acquisitionCost    Decimal            @db.Decimal(20, 4) // base currency
  residualValue      Decimal            @default(0) @db.Decimal(20, 4)
  usefulLifeMonths   Int
  method             DepreciationMethod @default(STRAIGHT_LINE)
  decliningRatePct   Decimal?           @db.Decimal(9, 4)
  depreciationStart  DateTime           @db.Date // first day of the first depreciation month
  location           String?
  costCenterId       String?
  status             AssetStatus        @default(ACTIVE)
  disposedAt         DateTime?          @db.Date
  disposalProceeds   Decimal?           @db.Decimal(20, 4)
  acquisitionEntryId String?
  createdById        String
  createdAt          DateTime           @default(now())
  category           AssetCategory      @relation(fields: [categoryId], references: [id])
  depreciation       DepreciationLine[]
  history            AssetTransaction[]

  @@unique([administrationId, number])
  @@index([organizationId])
}

/// One month of depreciation for one asset. Unique per asset and month: a month can never be depreciated twice.
model DepreciationLine {
  id             String   @id @default(cuid())
  organizationId String
  assetId        String
  year           Int
  month          Int
  amount         Decimal  @db.Decimal(20, 4)
  entryId        String
  createdAt      DateTime @default(now())
  asset          Asset    @relation(fields: [assetId], references: [id])

  @@unique([assetId, year, month])
  @@index([organizationId])
  @@index([entryId])
}

enum AssetTransactionType {
  ACQUISITION
  DEPRECIATION
  TRANSFER
  DISPOSAL
}

model AssetTransaction {
  id             String               @id @default(cuid())
  organizationId String
  assetId        String
  type           AssetTransactionType
  date           DateTime             @db.Date
  amount         Decimal?             @db.Decimal(20, 4)
  entryId        String?
  details        Json?
  createdById    String
  createdAt      DateTime             @default(now())
  asset          Asset                @relation(fields: [assetId], references: [id])

  @@index([organizationId])
  @@index([assetId])
}

// ───────────── Phase 4: industry templates ─────────────

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
}

/// Industry template. ownerOrganizationId null = platform template (read-only for tenants); otherwise a custom template of that organisation.
model IndustryTemplate {
  id                  String                    @id @default(cuid())
  ownerOrganizationId String?
  code                String
  name                String
  nameEn              String?
  description         String?
  descriptionEn       String?
  basedOnId           String?
  status              RecordStatus              @default(ACTIVE)
  createdAt           DateTime                  @default(now())
  versions            IndustryTemplateVersion[]

  @@unique([ownerOrganizationId, code])
}

/// Immutable once PUBLISHED (trigger). content = validated JSON (accounts, journals, asset categories, dimensions, KPIs).
model IndustryTemplateVersion {
  id                  String                @id @default(cuid())
  ownerOrganizationId String?
  templateId          String
  version             Int
  status              TemplateVersionStatus @default(DRAFT)
  content             Json
  contentHash         String
  changelog           String?
  publishedAt         DateTime?
  createdById         String?
  createdAt           DateTime              @default(now())
  template            IndustryTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}
