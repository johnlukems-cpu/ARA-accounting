# ARA Accounting — environment variables.
# Copy to .env.local for development. In production set these in the Vercel project settings.
# Phase 1 foundation needs none of them yet; they are listed so the deployment can be prepared.

# PostgreSQL (Neon via Vercel Marketplace, region US-East). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Document storage: either S3-compatible or Vercel Blob
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BLOB_READ_WRITE_TOKEN=
