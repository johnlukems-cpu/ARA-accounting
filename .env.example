# ARA Accounting — environment variables (see docs/DEPLOYMENT_GUIDE.md).
# Copy to .env for local development. In production set these in the Vercel project settings. Never commit real values.

# Validate a configuration with `npm run check:env` (presence and format only; values are never printed).
# The Vercel build runs it and stops the deploy on errors.

# PostgreSQL 16. On Vercel + Neon (region US-East) the integration sets both:
#   DATABASE_URL           = the POOLED host (…-pooler…), with ?sslmode=require   → used by the app
#   DATABASE_URL_UNPOOLED  = the DIRECT host (no -pooler), same database, sslmode=require → used by migrations
DATABASE_URL=postgresql://user:password@localhost:5432/ara_accounting
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/ara_accounting

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts MFA secrets. Changing it invalidates existing MFA set-ups.
ENCRYPTION_KEY=
# Protects /api/cron/* (Vercel sends it as a Bearer token). At least 32 characters: openssl rand -hex 32.
# Without it every cron call is refused.
CRON_SECRET=
# Optional: registrations allowed per IP address per hour (default 5).
REGISTER_LIMIT_PER_HOUR=

# Public https origin of the application, without a path (used in e-mail links; never taken from the request).
# On Vercel the production domain is used while empty.
APP_URL=

# Optional SMTP for e-mail (invitations, password reset, verification). Without it, links are shown once to administrators.
# Test: `npm run smtp:test -- you@your-domain.sr` or Platformbeheer → Productiegereedheid → Testbericht.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ARA Accounting <no-reply@example.sr>"

# Optional: error monitoring. An https webhook of the owner's monitoring/alerting service; every server error is POSTed
# there as redacted JSON (no message bodies, amounts or personal data). Without it errors only go to the platform log.
ERROR_REPORT_URL=

# Optional: ARA Scan AI recognition (Claude). Used only when an organisation switches AI on (Automatisering en AI).
ANTHROPIC_API_KEY=

# Fallback trial length in days for new organisations; the setting in Platformbeheer → Pakketten takes precedence.
TRIAL_DAYS=30
# Comma-separated e-mail addresses that get platform administration rights at seed time.
PLATFORM_ADMIN_EMAILS=
